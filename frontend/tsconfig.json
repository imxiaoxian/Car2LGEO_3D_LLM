{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-isolation/types/**/*.ts",
    ".next-delivery-20261019-v18/types/**/*.ts",
    ".next-delivery-20261019-v19/types/**/*.ts",
    ".next-delivery-20261019-v20/types/**/*.ts",
    ".next-delivery-20261019-v21/types/**/*.ts",
    ".next-delivery-20261019-v23/types/**/*.ts",
    ".next-delivery-20261019-v24/types/**/*.ts",
    ".next-delivery-20261019-v26/types/**/*.ts",
    ".next-delivery-20261020-v25/types/**/*.ts",
    ".next-delivery-20261020-v26-check/types/**/*.ts",
    ".next-delivery-20261020-v27-check/types/**/*.ts",
    ".next-delivery-20261020-v28-check/types/**/*.ts",
    ".next-delivery-20261020-v30/types/**/*.ts",
    ".next-object-loop-20261029/types/**/*.ts",
    ".next-object-loop-20261029-v15/types/**/*.ts",
    ".next-rolling-wheel-20261029-v17/types/**/*.ts",
    ".next-chassis-20261029-v1/types/**/*.ts",
    ".next-axial-mount-20261029-v19/types/**/*.ts",
    ".next-autonomous-wheel-20261029-v1/types/**/*.ts",
    ".next-autonomous-chassis-20261029-v1/types/**/*.ts",
    ".next-native-search-20261029-v1/types/**/*.ts",
    ".next-axial-clearance-20261029-v1/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    "vite.config.ts"
  ]
}
