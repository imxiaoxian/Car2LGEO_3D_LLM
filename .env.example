# Read-only reuse of the original project's GPT reference image service.
CAR2LEGO_SOURCE_ROOT=D:/lego
# Optional Python with the original service dependencies installed.
# CAR2LEGO_SOURCE_PYTHON=D:/python/anaconda/python.exe
# API configuration is inherited from CAR2LEGO_SOURCE_ROOT/backend/.env.
# Vehicle dimensions are obtained directly through OPENAI_MODEL dialogue.
# OPENAI_MODEL=gpt-6.1-sol
# Desktop jobs and CLI setup/run/reconstruct default to gpt-blender in this project.
# Explicit desktop modes: gpt-blender, hunyuan-mv (envelope fitter), hybrid (native planner).
# Blender modelling, repairs and visual review use an independent model.
# CAR2LEGO_BLENDER_MODEL=gpt-6-astra
# CAR2LEGO_MCP_PYTHON=D:/python/anaconda/python.exe
# Optional Blender MCP read/process timeout in seconds (default 600).
# CAR2LEGO_MCP_TIMEOUT=600
# CAR2LEGO_BLENDER=D:/lego/backend/storage/tool_research/blender-4.5.14-windows-x64/blender.exe
# Backend and frontend defaults are 8777 and 8778; use start-web.ps1 overrides if needed.
# Maximum simultaneous generated images across bridge processes: 5.
# Assembly alternatives use process environment variables inherited by the API.
# Keep legacy as the default until an accepted same-input comparison exists.
# ASSEMBLY_PLANNER=legacy
# CODEX_CLI_PATH=C:/path/to/codex.exe
# ASSEMBLY_CODEX_MODEL=gpt-6.1-sol
# Independent local model services; never a fallback chain.
# ASSEMBLY_LOCAL_BASE_URL=http://127.0.0.1:8781
# ASSEMBLY_LOCAL_FINETUNED_URL=http://127.0.0.1:8783
# ASSEMBLY_PLANNER=auto requires a validated data/assembly-agent/winner.json.
# Independent BrickLayer checks: auto=diagnostic, required=enforced, off=disabled.
# Install .[brickwright] in this project's environment; no fallback geometry is invented.
# CAR2LEGO_BRICKLAYER_AUDIT=auto
